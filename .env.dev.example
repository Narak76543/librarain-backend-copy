# Development example
# Copy this file to .env.dev and edit values for your local PostgreSQL.
APP_ENV=development

DB_USER=postgres
DB_PASSWORD=postgres
DB_SERVER=localhost
DB_PORT=5432
DB_NAME=your_local_db

JWT_SECRET_KEY=dev-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

SINGLE_SESSION_LOGIN=true
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15

MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

GOOGLE_MAPS_API_KEY=
GOOGLE_CLIENT_ID=
